





import seaborn as sns

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd




plt.style.use('fivethirtyeight')





data=sns.load_dataset('tips')


data



data.head()






# Plot here 
sns.relplot(x='total_bill',y='tip',data=data)

# there is a hidden parameter kind by default kind='scatter'







# Based on the smoker or not
sns.relplot(x='total_bill',y='tip',hue='smoker',data=data)





sns.relplot(x='total_bill',y='tip',hue='smoker',style='sex',data=data)





sns.relplot(x='total_bill',y='tip',hue='smoker',style='sex',size='size',data=data)





sns.scatterplot(x='total_bill',y='tip',hue='smoker',data=data)












# x-axis -> Categroical Data
# y-axis -> Numerical data



plt.style.use('fivethirtyeight')


tips=sns.load_dataset('tips')



tips.head()


### STRIP PLOTS
sns.catplot(x='day',y='tip',kind='strip',jitter=1.2,data=tips)
# jitter hidden parameter noise using 




### STRIP PLOTS
sns.catplot(x='day',y='tip',kind='strip',jitter=0,data=tips)
# jitter hidden parameter noise using 



sns.catplot(x='day',y='tip',kind='strip',data=tips)
# jitter hidden parameter noise without using 





### SWARM PLOTS
sns.catplot(x='day',y='tip',kind='swarm',data=tips)

## Provides us the distribution of the data 
## the difference between swarm and strip plots



# using hue parameter 
sns.catplot(x='day',y='tip',kind='swarm',hue='sex',data=tips)



## USING SWARMPLOTS FUNCTION DIRECCTLY

sns.swarmplot(x='day',y='tip',hue='sex',data=tips)








# BOX PLOT :
sns.boxplot(tips['tip'])



sns.boxplot(tips['total_bill'])


# Categorical Data

sns.catplot(x='day',y='total_bill', kind='box',data=tips)
# now i have a perspective of numerical data using the categgory



sns.catplot(x='day',y='total_bill',hue='sex',kind='box',data=tips)








sns.violinplot(tips['total_bill'])


sns.catplot(x='day',y='total_bill',kind='violin',data=tips)


## hue paraameteer

sns.catplot(x='day',y='total_bill',kind='violin',hue='sex',data=tips)


# split=True

sns.catplot(x='day',y='total_bill',kind='violin',hue='sex',split=True,data=tips)






sns.catplot(x='smoker',y='total_bill',kind='bar',data=tips)


# hue parameter
sns.catplot(x='smoker',y='total_bill',hue='sex',kind='bar',data=tips)


# parameter  estimator
sns.catplot(x='smoker',y='total_bill',hue='sex',estimator=np.median,kind='bar',data=tips)





sns.catplot(x='sex',hue='smoker',kind='count',data=tips)





